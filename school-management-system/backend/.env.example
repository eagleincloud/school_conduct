# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
USE_POSTGRES=True
ALLOWED_HOSTS=api.example.com
PUBLIC_API_BASE_URL=https://api.example.com

# PostgreSQL / Supabase
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=db.example.com
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Browser/mobile origins
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=https://app.example.com

# HTTPS security (enable after the reverse proxy/certificate is ready)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Authentication and API limits
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
API_ANON_RATE=300/minute
API_USER_RATE=600/minute
API_LOGIN_RATE=5/minute
API_UPLOAD_RATE=10/minute
API_REPORT_RATE=10/minute
API_ENQUIRY_RATE=5/hour
API_PAGE_SIZE=50
API_MAX_BULK_ROWS=1000
API_MAX_EXPORT_ROWS=10000
API_MAX_UPLOAD_BYTES=10485760
GALLERY_SIGNED_URL_TTL_SECONDS=300

# Media storage
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Email
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
CONTACT_EMAIL=replace-me

# Biometric TCP service
BIOMETRIC_TCP_HOST=0.0.0.0
BIOMETRIC_TCP_PORT=5555
BIOMETRIC_TCP_SOCKET_TIMEOUT=15
BIOMETRIC_TCP_MAX_PAYLOAD_BYTES=65536
BIOMETRIC_SBXPC_IDLE_TIMEOUT_SECONDS=86400
BIOMETRIC_SBXPC_CLOSE_AFTER_ACK=False
